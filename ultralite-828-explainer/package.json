{
  "name": "motu-ultralite828-explainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOTU UltraLite-mk5 & 828 \u2014 a five-minute landscape explainer at 3840x2160. Shivansh Electronics \u2014 exclusive distributor of MOTU for East and North-East India.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "assets": "python3 scripts/prep_assets.py",
    "audio": "python3 scripts/gen_audio.py",
    "coverage": "node --experimental-strip-types scripts/coverage.mjs",
    "framing": "node --experimental-strip-types scripts/framing.mjs",
    "verify:parts": "sh scripts/verify-parts.sh",
    "render:video": "sh scripts/render.sh Explainer motu-ultralite828-explainer 9424 344",
    "timeline": "node --experimental-strip-types scripts/timeline.mjs",
    "pipeline": "sh scripts/pipeline.sh",
    "cover:video": "remotion still ThumbnailVideo out/motu-ultralite828-explainer-cover.png",
    "script": "node --experimental-strip-types scripts/script-doc.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.497",
    "@remotion/cli": "4.0.497",
    "@remotion/renderer": "4.0.497",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.497"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
